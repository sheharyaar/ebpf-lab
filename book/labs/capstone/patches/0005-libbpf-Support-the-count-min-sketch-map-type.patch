From 7cbab42dcd606e4e8d68d8b8aeb5b1e164d8710d Mon Sep 17 00:00:00 2001
From: "A. Reader" <reader@example.com>
Date: Fri, 13 Nov 2026 05:36:41 +0530
Subject: [PATCH bpf-next 5/8] libbpf: Support the count-min sketch map type

Add BPF_MAP_TYPE_COUNT_MIN to the map type names and teach the map
type probe to create one: no key, a value of a key and a count.
---
 tools/lib/bpf/libbpf.c        | 1 +
 tools/lib/bpf/libbpf_probes.c | 5 +++++
 2 files changed, 6 insertions(+)

diff --git a/tools/lib/bpf/libbpf.c b/tools/lib/bpf/libbpf.c
index 1368752aa..d07929ac8 100644
--- a/tools/lib/bpf/libbpf.c
+++ b/tools/lib/bpf/libbpf.c
@@ -197,6 +197,7 @@ static const char * const map_type_name[] = {
 	[BPF_MAP_TYPE_ARENA]			= "arena",
 	[BPF_MAP_TYPE_INSN_ARRAY]		= "insn_array",
 	[BPF_MAP_TYPE_RHASH]			= "rhash",
+	[BPF_MAP_TYPE_COUNT_MIN]		= "count_min",
 };
 
 static const char * const prog_type_name[] = {
diff --git a/tools/lib/bpf/libbpf_probes.c b/tools/lib/bpf/libbpf_probes.c
index e40819465..e123f6ef0 100644
--- a/tools/lib/bpf/libbpf_probes.c
+++ b/tools/lib/bpf/libbpf_probes.c
@@ -351,6 +351,11 @@ static int probe_map_create(enum bpf_map_type map_type)
 		key_size = 0;
 		max_entries = 1;
 		break;
+	case BPF_MAP_TYPE_COUNT_MIN:
+		key_size = 0;
+		value_size = 2 * sizeof(__u64); /* a key, then a count */
+		max_entries = 1;
+		break;
 	case BPF_MAP_TYPE_ARENA:
 		key_size	= 0;
 		value_size	= 0;
-- 
