diff --git a/tools/testing/selftests/bpf/benchs/bench_count_min_map.c b/tools/testing/selftests/bpf/benchs/bench_count_min_map.c
new file mode 100644
index 000000000..2f454c592
--- /dev/null
+++ b/tools/testing/selftests/bpf/benchs/bench_count_min_map.c
@@ -0,0 +1,229 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <argp.h>
+#include <sys/random.h>
+#include "bench.h"
+#include "count_min_bench.skel.h"
+#include "bpf_util.h"
+
+#define MAX_KEYS (1 << 20)
+
+static struct ctx {
+	struct count_min_bench *skel;
+} ctx;
+
+static struct {
+	__u32 width;
+	__u32 depth;
+	__u32 nr_keys;
+} args = {
+	.width = 2719,		/* epsilon = e / width = 0.001 */
+	.depth = 5,		/* delta = exp(-depth) = 0.0067 */
+	.nr_keys = 10000,
+};
+
+enum {
+	ARG_CMS_WIDTH = 9100,
+	ARG_CMS_DEPTH = 9101,
+	ARG_CMS_NR_KEYS = 9102,
+};
+
+static const struct argp_option opts[] = {
+	{ "cms_width", ARG_CMS_WIDTH, "WIDTH", 0,
+		"Set the number of counters in each row of the sketch"},
+	{ "cms_depth", ARG_CMS_DEPTH, "DEPTH", 0,
+		"Set the number of rows of the sketch (1 to 15)"},
+	{ "cms_nr_keys", ARG_CMS_NR_KEYS, "NR_KEYS", 0,
+		"Set the number of distinct keys counted"},
+	{},
+};
+
+static error_t parse_arg(int key, char *arg, struct argp_state *state)
+{
+	long ret;
+
+	switch (key) {
+	case ARG_CMS_WIDTH:
+		ret = strtol(arg, NULL, 10);
+		if (ret < 1 || ret > UINT_MAX / 15) {
+			fprintf(stderr, "Invalid width\n");
+			argp_usage(state);
+		}
+		args.width = ret;
+		break;
+	case ARG_CMS_DEPTH:
+		ret = strtol(arg, NULL, 10);
+		if (ret < 1 || ret > 15) {
+			fprintf(stderr, "Invalid depth: 1 to 15\n");
+			argp_usage(state);
+		}
+		args.depth = ret;
+		break;
+	case ARG_CMS_NR_KEYS:
+		ret = strtol(arg, NULL, 10);
+		if (ret < 1 || ret > MAX_KEYS) {
+			fprintf(stderr, "Invalid number of keys: 1 to %d\n", MAX_KEYS);
+			argp_usage(state);
+		}
+		args.nr_keys = ret;
+		break;
+	default:
+		return ARGP_ERR_UNKNOWN;
+	}
+
+	return 0;
+}
+
+/* exported into benchmark runner */
+const struct argp bench_count_min_map_argp = {
+	.options = opts,
+	.parser = parse_arg,
+};
+
+static void validate(void)
+{
+	if (env.consumer_cnt != 0) {
+		fprintf(stderr, "The count-min benchmarks do not support consumer\n");
+		exit(1);
+	}
+}
+
+static void *producer(void *input)
+{
+	while (true)
+		syscall(__NR_getpgid);
+
+	return NULL;
+}
+
+static void setup(const char *prog_name, enum bpf_map_type hash_type)
+{
+	struct count_min_bench *skel;
+	struct bpf_program *prog;
+	struct bpf_link *link;
+	__u32 i;
+
+	setup_libbpf();
+
+	skel = count_min_bench__open();
+	if (!skel) {
+		fprintf(stderr, "failed to open skeleton\n");
+		exit(1);
+	}
+	ctx.skel = skel;
+
+	bpf_map__set_max_entries(skel->maps.cms, args.width);
+	bpf_map__set_map_extra(skel->maps.cms, args.depth);
+	bpf_map__set_type(skel->maps.hashmap, hash_type);
+	bpf_map__set_max_entries(skel->maps.hashmap, args.nr_keys);
+	skel->rodata->nr_keys = args.nr_keys;
+
+	bpf_object__for_each_program(prog, skel->obj)
+		bpf_program__set_autoload(prog, false);
+	prog = bpf_object__find_program_by_name(skel->obj, prog_name);
+	bpf_program__set_autoload(prog, true);
+
+	if (count_min_bench__load(skel)) {
+		fprintf(stderr, "failed to load skeleton\n");
+		exit(1);
+	}
+
+	for (i = 0; i < args.nr_keys; i++)
+		if (getrandom(&skel->bss->keys[i], sizeof(__u64), 0) != sizeof(__u64)) {
+			fprintf(stderr, "failed to get random keys\n");
+			exit(1);
+		}
+
+	link = bpf_program__attach(prog);
+	if (!link) {
+		fprintf(stderr, "failed to attach program\n");
+		exit(1);
+	}
+}
+
+static void push_setup(void)
+{
+	setup("cms_push", BPF_MAP_TYPE_HASH);
+}
+
+static void peek_setup(void)
+{
+	setup("cms_peek", BPF_MAP_TYPE_HASH);
+}
+
+static void hash_setup(void)
+{
+	setup("hash_count", BPF_MAP_TYPE_HASH);
+}
+
+static void lru_setup(void)
+{
+	setup("hash_count", BPF_MAP_TYPE_LRU_HASH);
+}
+
+static void measure(struct bench_res *res)
+{
+	static unsigned long last_hits, last_drops;
+	unsigned long hits = 0, drops = 0;
+	unsigned int nr_cpus = bpf_num_possible_cpus();
+	unsigned int i;
+
+	if (ctx.skel->bss->error) {
+		fprintf(stderr, "error (%d) in the count-min program\n",
+			ctx.skel->bss->error);
+		exit(1);
+	}
+
+	for (i = 0; i < nr_cpus && i < 256; i++) {
+		hits += ctx.skel->bss->percpu_stats[i].hits;
+		drops += ctx.skel->bss->percpu_stats[i].drops;
+	}
+	res->hits = hits - last_hits;
+	res->drops = drops - last_drops;
+	last_hits = hits;
+	last_drops = drops;
+}
+
+const struct bench bench_count_min_push = {
+	.name = "count-min-push",
+	.argp = &bench_count_min_map_argp,
+	.validate = validate,
+	.setup = push_setup,
+	.producer_thread = producer,
+	.measure = measure,
+	.report_progress = hits_drops_report_progress,
+	.report_final = hits_drops_report_final,
+};
+
+const struct bench bench_count_min_peek = {
+	.name = "count-min-peek",
+	.argp = &bench_count_min_map_argp,
+	.validate = validate,
+	.setup = peek_setup,
+	.producer_thread = producer,
+	.measure = measure,
+	.report_progress = hits_drops_report_progress,
+	.report_final = hits_drops_report_final,
+};
+
+const struct bench bench_count_min_hash = {
+	.name = "count-min-hash",
+	.argp = &bench_count_min_map_argp,
+	.validate = validate,
+	.setup = hash_setup,
+	.producer_thread = producer,
+	.measure = measure,
+	.report_progress = hits_drops_report_progress,
+	.report_final = hits_drops_report_final,
+};
+
+const struct bench bench_count_min_lru = {
+	.name = "count-min-lru",
+	.argp = &bench_count_min_map_argp,
+	.validate = validate,
+	.setup = lru_setup,
+	.producer_thread = producer,
+	.measure = measure,
+	.report_progress = hits_drops_report_progress,
+	.report_final = hits_drops_report_final,
+};
diff --git a/tools/testing/selftests/bpf/progs/count_min_bench.c b/tools/testing/selftests/bpf/progs/count_min_bench.c
new file mode 100644
index 000000000..dd1a7e087
--- /dev/null
+++ b/tools/testing/selftests/bpf/progs/count_min_bench.c
@@ -0,0 +1,102 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <linux/bpf.h>
+#include <bpf/bpf_helpers.h>
+#include "bpf_misc.h"
+
+char _license[] SEC("license") = "GPL";
+
+#define MAX_KEYS	(1 << 20)
+#define OPS_PER_RUN	1024
+
+struct cms_value {
+	__u64 key;
+	__u64 count;
+};
+
+struct {
+	__uint(type, BPF_MAP_TYPE_COUNT_MIN);
+	__type(value, struct cms_value);
+	/* width (max_entries) and depth (map_extra) are set by the bench */
+} cms SEC(".maps");
+
+struct {
+	__uint(type, BPF_MAP_TYPE_HASH);
+	__type(key, __u64);
+	__type(value, __u64);
+	/* max_entries and the type (HASH or LRU_HASH) are set by the bench */
+} hashmap SEC(".maps");
+
+__u64 keys[MAX_KEYS];		/* random keys, filled by the bench */
+const volatile __u32 nr_keys = 1;
+
+struct {
+	__u32 hits;
+	__u32 drops;
+} __attribute__((__aligned__(256))) percpu_stats[256];
+
+int error;
+
+static __always_inline __u64 next_key(__u32 *idx)
+{
+	*idx = (*idx + 1) % nr_keys;
+	return keys[*idx & (MAX_KEYS - 1)];
+}
+
+static __always_inline void log_hit(void)
+{
+	percpu_stats[bpf_get_smp_processor_id() & 255].hits++;
+}
+
+SEC("fentry/" SYS_PREFIX "sys_getpgid")
+int cms_push(void *ctx)
+{
+	struct cms_value v = { .count = 1 };
+	__u32 i, idx = bpf_get_prandom_u32();
+
+	for (i = 0; i < OPS_PER_RUN; i++) {
+		v.key = next_key(&idx);
+		if (bpf_map_push_elem(&cms, &v, BPF_ANY)) {
+			error |= 1;
+			return 0;
+		}
+		log_hit();
+	}
+	return 0;
+}
+
+SEC("fentry/" SYS_PREFIX "sys_getpgid")
+int cms_peek(void *ctx)
+{
+	struct cms_value v = {};
+	__u32 i, idx = bpf_get_prandom_u32();
+
+	for (i = 0; i < OPS_PER_RUN; i++) {
+		v.key = next_key(&idx);
+		if (bpf_map_peek_elem(&cms, &v) < 0) {
+			error |= 2;
+			return 0;
+		}
+		log_hit();
+	}
+	return 0;
+}
+
+/* the write counter's way of counting in a hash: add in place, insert once */
+SEC("fentry/" SYS_PREFIX "sys_getpgid")
+int hash_count(void *ctx)
+{
+	__u32 i, idx = bpf_get_prandom_u32();
+	__u64 key, one = 1, *c;
+
+	for (i = 0; i < OPS_PER_RUN; i++) {
+		key = next_key(&idx);
+		c = bpf_map_lookup_elem(&hashmap, &key);
+		if (c)
+			__sync_fetch_and_add(c, 1);
+		else if (bpf_map_update_elem(&hashmap, &key, &one, BPF_NOEXIST))
+			percpu_stats[bpf_get_smp_processor_id() & 255].drops++;
+		log_hit();
+	}
+	return 0;
+}
